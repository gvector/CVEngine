# CVEngine configuration
# Copy to .env and adjust. All variables are optional; defaults shown.

# --- LLM provider (agents, sectioning, synthesis) ---
CVENGINE_LLM_PROVIDER=ollama          # "ollama" | "openai"
CVENGINE_LLM_MODEL=llama3.1:8b
CVENGINE_LLM_BASE_URL=http://localhost:11434
# CVENGINE_LLM_API_KEY=sk-...           # required when provider=openai
# CVENGINE_LLM_TEMPERATURE=0.0

# --- Embedding backend ---
# backend: "ollama" (local /api/embed, uses your downloaded embeddinggemma) or
#          "sentence-transformers" (in-process, e.g. nomic)
CVENGINE_EMBEDDING_BACKEND=ollama
CVENGINE_EMBEDDING_MODEL=embeddinggemma:300m
CVENGINE_EMBEDDING_DIMENSION=768
CVENGINE_EMBEDDING_BASE_URL=http://localhost:11434
# Task prefixes for sentence-transformers backend (empty for embeddinggemma;
# nomic uses "search_query: " / "search_document: ")
CVENGINE_EMBEDDING_QUERY_PREFIX=
CVENGINE_EMBEDDING_DOCUMENT_PREFIX=

# --- Chroma (docker-compose) ---
CVENGINE_CHROMA_HOST=localhost
CVENGINE_CHROMA_PORT=8000
CVENGINE_CHROMA_COLLECTION=cvs__embeddinggemma-300m__v1
CVENGINE_CHROMA_TEST_COLLECTION=cvs__embeddinggemma-300m__v1__test
CVENGINE_CHROMA_SYNTH_COLLECTION=cvs__embeddinggemma-300m__v1__synth

# --- Scoring ---
CVENGINE_SCORING_ALPHA=0.8
CVENGINE_SCORING_BETA=0.2
# Seniority/experience boost: 0 = off, e.g. 0.2 to prefer more competent resources
CVENGINE_SCORING_COMPETENCE_WEIGHT=0.0
CVENGINE_SCORING_TOP_K_PER_QUERY=30
CVENGINE_SCORING_DEFAULT_TOP_K=20
CVENGINE_SCORING_RERANK_TOP_N=100
CVENGINE_SCORING_RERANK=true
# JSON dict of per-section multipliers, e.g. {"skills":1.0,"experience":0.9,"other":0.5}
CVENGINE_SCORING_SECTION_MULTIPLIERS={"skills":1.0,"experience":0.9,"projects":0.8,"certifications":0.7,"summary":0.7,"education":0.6,"languages":0.6,"other":0.5}

# --- Ingestion ---
CVENGINE_INGESTION_WORKERS=1

# --- Misc ---
CVENGINE_DATA_DIR=cvengine_data
CVENGINE_LOG_LEVEL=INFO
# Read-only web viewer for Chroma collections at /viewer (false = disabled)
CVENGINE_VIEWER_ENABLED=false